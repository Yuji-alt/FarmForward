<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bone"
    android:paddingStart="16dp"
    android:fillViewport="true"
    android:paddingEnd="16dp">

    <LinearLayout
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/farmforward"
                android:padding="4dp"
                android:scaleType="fitStart" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/search_border"
                android:hint="@string/search_crops"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp"
                android:textColor="@color/kombuGreen"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/search_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/kombuGreen" />

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_box"
            android:src="@drawable/ic_settings"
            app:tint="@color/bone"
            android:padding="12dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvAddLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Crops"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kombuGreen"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollActiveCrops"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/cropListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="100"
            android:alignmentMode="alignMargins"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>