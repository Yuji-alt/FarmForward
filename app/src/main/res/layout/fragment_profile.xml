<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:orientation="vertical"
    android:background="@color/bone"
    android:padding="12dp">

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BACK BUTTON -->
            <ImageButton
                android:id="@+id/btn_back_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/kombuGreen" />

            <!-- MAIN INFO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/input_bg"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:elevation="4dp">

                <!-- CROP NAME -->

                <!-- CROP IMAGE -->
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="UserName"
                    android:textColor="@color/kombuGreen"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgCrop"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/agricultwo"
                    android:background="@drawable/rounded_box"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />


                <!-- DATE PLANTED -->
                <TextView
                    android:id="@+id/tvDatePlanted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email: user_email"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/kombuGreen"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/tvActiveplants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estimated Harvest: December 25"
                    android:textSize="20sp"
                    android:textColor="@color/kombuGreen"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yvHarvestedCrops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Growth Stage: Vegetative"
                    android:textColor="@color/kombuGreen"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/tvFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequently crop: Rice"
                    android:textSize="20sp"
                    android:textColor="@color/kombuGreen"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
