<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bone"
    android:fillViewport="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_close_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tint="@color/kombuGreen"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCropName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                tools:text="RICE"
                android:padding="8dp"
                android:textAlignment="center"
                android:textColor="@color/kombuGreen"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/etDescription"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_box"
            android:clipToOutline="true"
            android:padding="10dp"
            android:gravity="top|start"
            android:src="@drawable/agricultwo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_crop"
                android:textStyle="bold"
                android:textColor="@color/kombuGreen"
                android:drawablePadding="8dp"
                app:backgroundTint="@color/kombuGreen"
                app:tint="@color/tan"
                android:padding="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textStyle="bold"
                android:textColor="@color/kombuGreen"
                android:drawablePadding="8dp"
                app:backgroundTint="@color/kombuGreen"
                app:tint="@color/tan"
                android:padding="8dp"/>
        </LinearLayout>

        <TableLayout
            android:id="@+id/tableCropInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/border"
            android:padding="8dp"
            android:stretchColumns="1">

            <TableRow>
                <TextView style="@style/LabelText" android:text="Area" android:background="@drawable/border" />
                <TextView android:id="@+id/tvArea" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1" />
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Soil Type" android:background="@drawable/border" />
                <TextView android:id="@+id/tvSoilType" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1"/>
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Irrigation Level" android:background="@drawable/border" />
                <TextView android:id="@+id/tvIrrigation" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1"/>
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Planting Density" android:background="@drawable/border" />
                <TextView android:id="@+id/tvDensity" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1"/>
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Fertilizer Used" android:background="@drawable/border" />
                <TextView android:id="@+id/tvFertilizer" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1"/>
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Weather Condition" android:background="@drawable/border" />
                <TextView android:id="@+id/tvWeather" style="@style/ValueText" android:maxLines="1" android:background="@drawable/border" />
            </TableRow>
            <TableRow>
                <TextView style="@style/LabelText" android:text="Region" android:background="@drawable/border" />
                <TextView android:id="@+id/tvRegion" style="@style/ValueText" android:background="@drawable/border"  android:maxLines="1"/>
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_box_display_leftside"
                android:gravity="center_vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE PLANTED"
                    android:textColor="@color/kombuGreen"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_box_display_rightside"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/bone" />
                <TextView
                    android:id="@+id/plantedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    android:textColor="@color/bone"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_box_display_leftside"
                android:gravity="center_vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/estimated_harvest_yield"
                    android:textColor="@color/kombuGreen"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_box_display_rightside"
                android:gravity="center_vertical"
                android:padding="12dp">
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_growth"
                    app:tint="@color/bone" />
                <TextView
                    android:id="@+id/harvestYield"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="@color/bone"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnHarvest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Harvest"
            android:backgroundTint="@color/kombuGreen"
            android:textColor="@color/bone" />
        <Button
            android:id="@+id/btnViewOnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Location on Map"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/kombuGreen"
            android:textColor="@color/bone"/>

    </LinearLayout>
</ScrollView>