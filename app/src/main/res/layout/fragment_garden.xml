<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bone"
    android:fillViewport="true">
    <LinearLayout
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp">

            <TextView
                android:id="@+id/app_logo_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/roboto"
                android:gravity="start"
                android:padding="4dp"
                android:text="Garden"
                android:textColor="@color/kombuGreen"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/search_border"
                android:hint="@string/search_crops"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp"
                android:textColor="@color/kombuGreen"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/search_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/kombuGreen" />

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:background="@android:color/transparent"
            app:tint="@color/kombuGreen" />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/kombuGreen"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:alpha="5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Add Plant -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="1dp">

            <ImageButton
                android:id="@+id/btnAdd"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/plus"
                android:contentDescription="Add Plant"
                app:tint="@color/kombuGreen"
                android:padding="5dp"/>

            <TextView
                android:id="@+id/tvAddLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add new plant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/kombuGreen"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/activeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Active Crops"
                android:fontFamily="@font/roboto"
                android:padding="5dp"
                android:src="@drawable/ic_circle"
                app:tint="@color/kombuGreen" />

            <TextView
                android:id="@+id/tvActiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"
                android:text="Active:"
                android:textColor="@color/kombuGreen"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"
                android:text="0"
                android:textColor="@color/kombuGreen"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="1dp"
            >

            <ImageView
                android:id="@+id/harvestIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="5dp"
                android:src="@drawable/ic_circle"
                app:tint="@color/cafenoir"
                android:contentDescription="Ready to Harvest"/>

            <TextView
                android:id="@+id/tvHarvestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to harvest:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/kombuGreen"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto"/>

            <TextView
                android:id="@+id/tvHarvestNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0"
                android:textColor="@color/kombuGreen"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto"/>
        </LinearLayout>
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/scrollActiveCrops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/cropListContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:alpha="5"
        android:background="@color/kombuGreen" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Harvested Crops"
        android:textColor="@color/kombuGreen"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto"/>

    <ScrollView
        android:id="@+id/scrollHarvestedCrops"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp">

        <LinearLayout
            android:id="@+id/harvestedCropListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
