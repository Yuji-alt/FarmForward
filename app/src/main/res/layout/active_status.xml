<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="2dp"
    android:background="@drawable/item_card_border"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgCrop"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:src="@drawable/agricultwo"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_box"
            android:layout_marginEnd="12dp"
            android:padding="10dp"
            android:contentDescription="@string/crop_image"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/tvCropName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            tools:text="Crop Name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/kombuGreen"
            android:gravity="center_vertical|start" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="DAYS"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/kombuGreen" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="HARVEST"
                android:textSize="13sp"
                android:textColor="@color/kombuGreen"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView
            android:paddingStart="10dp"
            android:id="@+id/imgArrow"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_greater_than"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</FrameLayout>