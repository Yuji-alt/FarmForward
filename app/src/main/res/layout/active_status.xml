<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    android:elevation="2dp"
    android:background="@drawable/item_card_border"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgCrop"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:src="@drawable/agricultwo"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_box"
        android:padding="10dp"
        android:contentDescription="@string/crop_image"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginEnd="12dp"/>

    <ImageView
        android:id="@+id/imgArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_greater_than"
        app:tint="@color/kombuGreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/imgArrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="15 DAYS"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/kombuGreen"
            android:fontFamily="@font/noto_sans"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="HARVEST"
            android:textSize="12sp"
            android:textColor="@color/kombuGreen"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/noto_sans"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCropName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Crop Name"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/kombuGreen"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/roboto"
        app:layout_constraintStart_toEndOf="@+id/imgCrop"
        app:layout_constraintEnd_toStartOf="@+id/statusContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>